# ---- Server ----
PORT=3000
# NODE_ENV=production   # enables Secure cookies

# ---- Auth (CHANGE THESE IN PRODUCTION) ----
# Used to sign session JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7

# ---- Encryption at rest (CHANGE THIS IN PRODUCTION) ----
# Passphrase used to derive the AES-256-GCM key that encrypts CMS credentials.
# If you change it after storing credentials, existing secrets can't be decrypted.
APP_ENCRYPTION_KEY=change-me-to-a-long-random-passphrase

# ---- Data layer ----
DB_DRIVER=sqlite
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # when DB_DRIVER=postgres (future)

# ---- LLM: Anthropic Claude ----
# Leave blank to use the offline template generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com
